# .env.example
# 只放占位符；真实值放本地 .env（已被 .gitignore 排除），不得入库。
# 分隔与命名按 OpenAI-compatible 端点约定填写；不要在本文件里写任何真实 key。

# ---- LLM providers ----
# DeepSeek = reader + judge
DEEPSEEK_BASE_URL=
DEEPSEEK_API_KEY=
DEEPSEEK_READER_MODEL=
DEEPSEEK_JUDGE_MODEL=

# SiliconFlow = embedding + rerank
SILICONFLOW_BASE_URL=
SILICONFLOW_API_KEY=
SILICONFLOW_EMBEDDING_MODEL=
SILICONFLOW_RERANK_MODEL=

# MiniMax = 跨模型交叉复核 / 辅助 judge（非主 reader）
MINIMAX_BASE_URL=
MINIMAX_API_KEY=
MINIMAX_MODEL=

# ---- MySQL 8 ----
# compose 部署时，mysql 服务用这里的 MYSQL_PASSWORD 作为 root 口令（单一来源；必填）
MYSQL_HOST=127.0.0.1
MYSQL_PORT=3306
MYSQL_DATABASE=anchorline
MYSQL_USER=root
MYSQL_PASSWORD=

# ---- 评测 ----
EVAL_BUDGET_TOKENS=4000
EVAL_JUDGE_PROMPT_SHA256=

# ---- 可选：API 鉴权（默认关闭；设置后请求需带 X-API-Token）----
API_TOKEN=

# 可选：api 在宿主机的端口（默认 8000；与本机其他服务冲突时改，如 18000）
API_HOST_PORT=8000

# 可选：web 在宿主机的端口（默认 8080；冲突时改，如 18080）
WEB_HOST_PORT=8080

# ---- 可选：日志 ----
LOG_LEVEL=INFO
LOG_FORMAT=text

# ---- 可选：记忆容量 ----
MEMORY_MAX_CURRENT_PER_ENTITY=200

# ---- 可选：LoreKeeper 知识库（kb_search；留空则禁用）----
LOREKEEPER_ENABLED=true
LOREKEEPER_LANCE_DIR=
LOREKEEPER_EMBED_MODEL=BAAI/bge-m3

# ---- 可选：流式模式（chunk=伪流式；real=真 token 流，多一次模型调用）----
STREAM_MODE=chunk
